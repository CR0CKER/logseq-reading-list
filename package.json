{
  "name": "logseq-reading-list",
  "description": "Add books to Logseq as rich, fully-populated pages (cover, author, ISBN, summary, tags) via Open Library or Google Books — with an optional visual reading list.",
  "author": "CR0CKER",
  "logseq": {
    "id": "reading-list",
    "title": "Reading List",
    "icon": "./icon.svg"
  },
  "main": "dist/index.html",
  "targets": {
    "main": false
  },
  "effect": true,
  "scripts": {
    "dev": "parcel src/index.html --public-url ./ --no-cache",
    "build": "parcel build --no-source-maps src/index.html --public-url ./",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@logseq/libs": "0.0.17",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "parcel": "^2.12.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
